.enrich-progress.json
.enrich-missing-progress.json

# Detox test artifacts (screenshots, logs from local test runs)
e2e/artifacts/

# Marketing automation local state (dashboard toggles, runtime data)
marketing/automation/content/platform-state.json
e2e/reports/
