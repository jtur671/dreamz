{
  "expo": {
    "name": "Dreamz",
    "slug": "dreamz",
    "scheme": "dreamz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dreamzjournal.app",
      "usesAppleSignIn": true,
      "buildNumber": "39",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Dreamz uses your microphone to record dreams by voice.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "tabletImage": "./assets/splash-icon-tablet.png",
        "resizeMode": "contain",
        "backgroundColor": "#1a1a2e"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.dreamzjournal.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-audio",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      "@config-plugins/detox",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8597027816949059~7210132219",
          "iosAppId": "ca-app-pub-8597027816949059~7899830102"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "7a63985f-a2fb-45fe-8dc8-311a9c270047"
      }
    }
  }
}
