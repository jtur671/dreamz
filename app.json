{
  "expo": {
    "name": "Dreamz",
    "slug": "dreamz",
    "scheme": "dreamz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dreamzjournal.app",
      "usesAppleSignIn": true,
      "buildNumber": "40",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Dreamz uses your microphone to record dreams by voice.",
        "NSUserTrackingUsageDescription": "Dreamz uses your advertising identifier to show relevant ads that keep the free tier available. You can change this any time in Settings.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "tabletImage": "./assets/splash-icon-tablet.png",
        "resizeMode": "contain",
        "backgroundColor": "#1a1a2e"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.dreamzjournal.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
