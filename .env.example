# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_PASSWORD=your-db-password

# Database encryption key — stored in private.encryption_config on Supabase.
# NEVER commit the real value. Keep a copy in your password manager.
# To rotate: UPDATE private.encryption_config SET value='new-key' WHERE key='encryption_key';
# Then re-encrypt all rows in private.dreams_encrypted and private.profiles_encrypted.
DB_ENCRYPTION_KEY=your-32-plus-byte-random-key-base64

# Optional: OpenAI (used server-side in Edge Functions, not here)
# OPENAI_API_KEY=sk-...

# RevenueCat (in-app purchases)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your-revenuecat-ios-key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your-revenuecat-android-key

# OAuth Providers (for Supabase Auth config push)
# Apple Sign In - from Apple Developer Console
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=your-apple-service-id
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=your-apple-private-key

# Google OAuth - from Google Cloud Console
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Gemini (mcp-image MCP server — for App Store asset generation)
GEMINI_API_KEY=your-gemini-api-key
